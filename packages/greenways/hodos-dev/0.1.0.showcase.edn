 [{:demo/id :explorer/project
   :demo/title "Explore a Hara project"
   :demo/summary "Inspect the complete immutable story project through the live files surface."
   :demo/view :explorer
   :demo/state :explorer/project
   :demo/project "showcase/explorer"
   :demo/surface :files
   :demo/docs "showcase/explorer/README.md"
   :demo/tags ["explorer" "workspace" "files"]
   :demo/theme :dark
   :demo/viewport {:viewport/width 1100 :viewport/height 720}
   :demo/default true}
  {:demo/id :editor/live
   :demo/title "Edit a Hara value"
   :demo/summary "Open the package story source in the live Hodos editor surface."
   :demo/view :editor
   :demo/state :editor/live
   :demo/project "showcase/editor"
   :demo/surface :code
   :demo/docs "showcase/editor/README.md"
   :demo/tags ["editor" "hara" "paredit"]
   :demo/theme :dark
   :demo/viewport {:viewport/width 1100 :viewport/height 720}}
  {:demo/id :preview/ready
   :demo/title "Render an interface value"
