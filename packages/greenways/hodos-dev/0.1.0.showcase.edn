   :demo/view :preview
   :demo/state :preview/ready
   :demo/project "showcase/preview"
   :demo/surface :preview
   :demo/docs "showcase/preview/README.md"
   :demo/tags ["preview" "hta" "sandbox"]
   :demo/theme :dark
   :demo/viewport {:viewport/width 900 :viewport/height 620}}
  {:demo/id :repl/ready
